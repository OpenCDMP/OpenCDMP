{
	"compileOnSave": false,
	"angularCompilerOptions": {
    "strictTemplates": false
  },
	"compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": false,
    "noUncheckedSideEffectImports": false,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "module": "es2020",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "typeRoots": [
      "node_modules/@types"
    ],
    "paths": {
      "@app/*": [
        "./src/app/*"
      ],
      "@common/*": [
        "./src/common/*"
      ],
      "@annotation-service/*": [
        "./src/annotation-service/*"
      ],
      "@notification-service/*": [
        "./src/notification-service/*"
      ],
      "kpi-service/*": [
        "./src/kpi-service/*"
      ]
    },
    "useDefineForClassFields": false
  }
}